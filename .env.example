# Local demo credentials only. Keep these values aligned with the checked-in
# MySQL bootstrap SQL; do not reuse them outside this isolated demo stack.
MYSQL_ROOT_PASSWORD=reagent-root-local-only
REAGENT_DB_USER=reagent_app
REAGENT_DB_PASSWORD=reagent-local-only
FAKE_OPS_DB_USER=fake_ops_app
FAKE_OPS_DB_PASSWORD=fake-ops-local-only

# Normal startup leaves the real OpenAI-compatible client selected. Readiness
# does not require a key; set this only when intentionally exercising it.
DEEPSEEK_API_KEY=

# Scenario scripts set these explicitly and restore safe defaults on exit.
REAGENT_DEMO_PROFILES=
AGENT_CAPABILITIES_ACCEPTANCE_ENABLED=false
AGENT_CAPABILITIES_CHAOS_ENABLED=false

REAGENT_HTTP_PORT=8080
JAEGER_UI_PORT=16686
